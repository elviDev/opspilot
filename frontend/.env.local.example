# --- Backend (server-only) ---------------------------------------------------
# FastAPI base URL. Only the Next.js server talks to it (BFF pattern), so it is
# never shipped to the browser. NEXT_PUBLIC_API_URL is still read as a fallback.
API_URL=http://localhost:8000

# --- Public site -------------------------------------------------------------
# Canonical origin used for metadata, sitemap, robots.txt, llms.txt and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Session / auth (optional) -----------------------------------------------
# Set BOTH to put the dashboard behind a password-protected session.
# Leave them empty to run the dashboard publicly (demo mode).
# Generate a secret with: openssl rand -base64 32
AUTH_SECRET=
DASHBOARD_PASSWORD=
